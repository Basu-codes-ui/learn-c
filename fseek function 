write a program that uses the functions ftell and fseek 
#include <stdio.h>

int main()
{
    FILE *fp;
    long n;
    int c;

    /* Create file and store characters */
    fp = fopen("RANDOM", "w");

    printf("Enter text (Press Ctrl+Z and Enter to stop):\n");

    while ((c = getchar()) != EOF)
        putc(c, fp);

    printf("\nNo. of characters entered = %ld\n", ftell(fp));

    fclose(fp);

    /* Open file for reading */
    fp = fopen("RANDOM", "r");

    n = 0L;

    printf("\nEvery 5th character:\n");

    while (!feof(fp))
    {
        fseek(fp, n, 0);

        if ((c = getc(fp)) != EOF)
            printf("Position %ld : %c\n", ftell(fp), c);

        n = n + 5L;
    }

    printf("\nContents in reverse order:\n");

    fseek(fp, -1L, 2);

    do
    {
        putchar(getc(fp));
    }
    while (!fseek(fp, -2L, 1));

    fclose(fp);

    return 0;
}
