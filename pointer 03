write a program using pointer to determine the length of a character string 
#include <stdio.h>

void main()
{
    char name[] = "DELHI";

    int length;

    char *cptr = name;

    printf("%s\n", name);

    while (*cptr != '\0')
    {
        printf("%c is stored at address %u\n", *cptr, cptr);

        cptr++;
    }

    length = cptr - name;

    printf("\nLength of string = %d\n", length);
}

