write a program to array member to represent the three subjects 

#include <stdio.h>

struct marks
{
    int sub[3];
    int total;
};

main()
{
    int i, j;

    struct marks student[3] =
    {
        45, 67, 81, 0,
        53, 69, 57, 0,
        36, 74, 80, 0
    };

    struct marks total;

    for(i = 0; i <= 2; i++)
    {
        for(j = 0; j <= 2; j++)
        {
            student[i].total += student[i].sub[j];
            total.sub[j] += student[i].sub[j];
        }

        total.total += student[i].total;
    }

    printf("\nSTUDENT TOTAL\n");

    for(i = 0; i <= 2; i++)
        printf("Student-%d = %d\n", i + 1, student[i].total);

    printf("\nSUBJECT TOTAL\n");

    for(j = 0; j <= 2; j++)
        printf("Subject-%d = %d\n", j + 1, total.sub[j]);

    printf("\nGrand Total = %d\n", total.total);
}