Read File Contents in Reverse Order Using fseek()
#include <stdio.h>

int main()
{
    FILE *fp;
    long size;
    char ch;

    fp = fopen("data.txt", "r");

    if(fp == NULL)
    {
        printf("File not found");
        return 1;
    }

    fseek(fp, 0, SEEK_END);

    size = ftell(fp);

    printf("Contents in reverse order:\n");

    while(size > 0)
    {
        fseek(fp, --size, SEEK_SET);
        ch = getc(fp);
        printf("%c", ch);
    }

    fclose(fp);

    return 0;
}
