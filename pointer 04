pointer program to swap two numbers without using the 3rd variable
#include <stdio.h>

int main()
{
    int a = 10, b = 20;

    int *p1 = &a;
    int *p2 = &b;

    printf("Before swap:\n");
    printf("*p1 = %d\n", *p1);
    printf("*p2 = %d\n", *p2);

    *p1 = *p1 + *p2;
    *p2 = *p1 - *p2;
    *p1 = *p1 - *p2;

    printf("\nAfter swap:\n");
    printf("*p1 = %d\n", *p1);
    printf("*p2 = %d\n", *p2);

    return 0;
}
a = 10
b = 20

p1 → a
p2 → b

Swapping process:
Plain text
*p1 = *p1 + *p2
10 + 20 = 30

*p2 = *p1 - *p2
30 - 20 = 10

*p1 = *p1 - *p2
30 - 10 = 20

Final values:
Plain text
a = 20
b = 10